+++ b/terminal-view/src/main/java/com/termux/view/IcuBidi.java
@@ -0,0 +1,35 @@
+package com.termux.view;
+
+import android.icu.text.Bidi;
+
+/**
+ * ICU4J backed implementation of {@link BidiLayout.VisualRuns}.
+ * <p/>
+ * This class references {@code android.icu} which is only available since Android 7.0
+ * (API level 24), so it must only be loaded after checking {@code Build.VERSION.SDK_INT}.
+ */
+final class IcuBidi {
+
+    private IcuBidi() {}
+
+    static BidiLayout.VisualRuns visualRuns(char[] line, int charsUsed) {
+        Bidi bidi = new Bidi(new String(line, 0, charsUsed), Bidi.DIRECTION_DEFAULT_LEFT_TO_RIGHT);
+        return new IcuVisualRuns(bidi);
+    }
+
+    private static final class IcuVisualRuns implements BidiLayout.VisualRuns {
+        private final Bidi mBidi;
+
+        IcuVisualRuns(Bidi bidi) {
+            mBidi = bidi;
+        }
+
+        @Override public int count() { return mBidi.countRuns(); }
+
+        @Override public int logicalStart(int run) { return mBidi.getRunStart(mBidi.getVisualRun(run)); }
+
+        @Override public int logicalLimit(int run) { return mBidi.getRunLimit(mBidi.getVisualRun(run)); }
+
+        @Override public boolean isRtl(int run) { return !mBidi.isLeftToRight(mBidi.getVisualRun(run)); }
+    }
+}
